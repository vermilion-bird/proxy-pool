          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 102,
      "type": "timeseries",
      "title": "Healthy Nodes by Region",
      "targets": [{"expr": "proxy_pool_nodes_healthy_by_region", "legendFormat": "{{region}}", "refId": "A"}],
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
