        {"expr": "sum(rate(proxy_pool_heartbeat_total[$__rate_interval]))", "legendFormat": "heartbeat", "refId": "B"}
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
