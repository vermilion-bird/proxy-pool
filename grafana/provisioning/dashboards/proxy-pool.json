          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 101,
      "type": "stat",
      "title": "Healthy Nodes",
      "targets": [{"expr": "proxy_pool_nodes_healthy", "legendFormat": "healthy", "refId": "A"}],
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "values": false, "fields": "", "limit": 100}}
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
