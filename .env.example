# Proxy Pool 环境变量模板 —— 复制为 .env 并填入真实值（.env 不入库）

# 管理 API 认证（v1.1.0+，生产必配）
# 逗号分隔的 API Key 列表
PP_API_KEYS=sk-xxxxxxxxxxxxxxxx

# 可选：来源 IP 白名单（IP 或 CIDR，逗号分隔）
PP_IP_WHITELIST=

# 可选：部署在反向代理后置 1，来源 IP 取 X-Forwarded-For
PP_TRUST_PROXY=0

# 调度（v1.2+）
PP_SCHED_MODE=weighted      # weighted 加权随机 | best 确定性选最优
PP_SCHED_W_SUCCESS=0.35    # 成功率权重
PP_SCHED_W_LATENCY=0.30    # 延迟权重
PP_SCHED_W_LOAD=0.20       # 负载权重
PP_SCHED_W_STABILITY=0.15  # 稳定性权重

# 健康检查（v1.1+，可选，默认值见注释）
PP_HC_INTERVAL=30          # 巡检间隔秒
PP_HC_TIMEOUT=5            # 探活超时秒
PP_HC_FAIL_DEGRADED=3      # 连续失败进入 degraded
PP_HC_FAIL_DEAD=5          # 连续失败进入 dead
PP_HC_RECOVER=3            # 连续成功恢复 healthy
PP_HC_HTTP_PROBE=1         # 是否启用 HTTP 深度探测
PP_HC_PROBE_URL=http://example.com

# 质量封禁（v1.2+）
PP_QUALITY_MIN_SUCCESS_RATE=0.5   # 成功率低于此值自动封禁
PP_QUALITY_MIN_REQUESTS=20        # 最少请求数（防小样本误判）

# Sticky Proxy（v1.2+）
PP_STICKY_TTL=1800                # 粘性绑定 TTL 秒（默认 30 分钟）
